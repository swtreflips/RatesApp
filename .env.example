# Supabase credentials — copy this file to .env.local for local dev,
# and set the same keys in Vercel → Project → Settings → Environment Variables.
#
# Both are PUBLIC, build-time values (Vite inlines anything prefixed VITE_).
# The anon key is safe to expose in the browser — Row Level Security protects data.
# NEVER put the service_role key or any secret in a VITE_ variable.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Geo/routing brain (geoapi-next, own Vercel project) — see BRAIN.md.
# Just a public URL, not a secret. Local dev of the brain: http://localhost:3000
VITE_GEO_API_URL=https://geoapi-next.vercel.app
